# Copy to .env.local for overrides, or set in CI environment.

# Base path for static assets (default '/'). For GitHub Pages at
# https://<user>.github.io/<repo>/ set to '/<repo>/'.
# VITE_BASE_PATH=/java_demo/

# Output directory for `vite build` (default '../src/main/resources/static'
# so the Render Dockerfile picks the bundle straight into the JAR).
# For GitHub Pages set to 'dist' so the artifact stays in frontend/.
# VITE_OUT_DIR=dist

# Where the frontend should call the API. Empty/unset -> '/api' (relative,
# works for local dev via Vite proxy and for the Render single-JAR deploy).
# For GitHub Pages set to the absolute Render URL so cross-origin works.
# VITE_API_BASE_URL=https://java-task-demo.onrender.com/api
